# Optional environment overrides (copy to .env locally; .env is gitignored).
# Values here override matching keys from config.local.json.

# Server bind: default 127.0.0.1 (loopback only). Set 0.0.0.0 only if you deliberately enable LAN.
YT_REMOTE_HOST=127.0.0.1
YT_REMOTE_PORT=8790

# Set to 1/true to listen on all interfaces (same as config allowLan). Prefer Private firewall + token.
YT_REMOTE_ALLOW_LAN=0

# Shared secret required for state-changing HTTP APIs and UI websocket when set.
# Generate something long and random, e.g. openssl rand -hex 32
YT_REMOTE_AUTH_TOKEN=

# Comma-separated Origin hosts allowed when LAN is enabled (examples: 192.168.1.20:8790,my-pc.local:8790)
YT_REMOTE_ALLOWED_HOSTS=

# Optional Chrome paths/profile for native open fallback and CDP helper
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
YT_REMOTE_CHROME_PROFILE_DIRECTORY=Default
YT_REMOTE_CHROME_PROFILE=
YT_REMOTE_CDP_PORT=9333
